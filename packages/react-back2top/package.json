{
  "name": "react-back2top",
  "version": "1.0.0",
  "description": "A React component for Back-To-Top button/link functionality",
  "keywords": [
    "back",
    "top",
    "react",
    "back-to-top",
    "back2top",
    "back-2-top",
    "button"
  ],
  "homepage": "https://github.com/tbolis/react-back2top",
  "bugs": "https://github.com/tbolis/react-back2top/issues",
  "author": {
    "name": "Thomas Bolis",
    "email": "thomas.bolis@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tbolis/react-back2top.git",
    "directory": "packages/react-back2top"
  },
  "sideEffects": false,
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "yarn typecheck && yarn test:coverage && yarn build",
    "clean": "rimraf lib coverage"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^5.0.5"
  }
}
