{
  "name": "react-back2top-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "showcase"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "yarn workspace react-back2top-showcase start",
    "build": "yarn workspace react-back2top build",
    "build:showcase": "yarn workspace react-back2top-showcase build",
    "typecheck": "yarn workspaces run typecheck",
    "lint": "eslint .",
    "test": "yarn workspace react-back2top test",
    "test:coverage": "yarn workspace react-back2top test:coverage",
    "clean": "yarn workspaces run clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "rimraf": "^6.1.3",
    "typescript": "^6",
    "typescript-eslint": "^8.72.1"
  }
}
